<mujoco model="differential_drive_robot">
  <!--
  Differential drive robot with 4 wheels
  Coordinate system: Z-up right-hand (MuJoCo standard)
  Robot heading: +Y direction (user's forward direction maps to +Y in ground plane)
  -->

  <worldbody>
    <!-- Chassis: position at z=0.0325 so chassis center is at wheel radius height -->
    <body name="chassis" pos="0 0 0.0325">
      <!-- Free joint - REQUIRED for robot to move -->
      <freejoint name="root"/>

      <!-- Main chassis box: 200mm x 180mm x 40mm, mass 380g -->
      <geom name="chassis_box" type="box" size="0.090 0.100 0.020"
            mass="0.380" rgba="0.3 0.3 0.3 1"/>

      <!-- Inertial properties -->
      <inertial pos="0 0 0" mass="0.380"
                diaginertia="8e-4 1.2e-3 1.5e-3"/>

      <!-- IR sensor sites: 8 channels, mounted at FRONT of robot -->
      <!-- User coordinates (mm): x=lateral, y=forward (132.1mm), relative to chassis center -->
      <!-- Robot frame: +Y is forward (vehicle heading direction) -->
      <!-- Conversion: user_x -> robot_x (lateral), user_y -> robot_y (forward) -->
      <site name="ir0" pos=" 0.0056944 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir1" pos=" 0.0170831 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir2" pos=" 0.0284719 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir3" pos=" 0.0398606 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir4" pos="-0.0056944 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir5" pos="-0.0170831 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir6" pos="-0.0284719 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>
      <site name="ir7" pos="-0.0398606 0.1321 -0.0325" size="0.005" rgba="1 0 0 0.8"/>

      <!-- IMU site: at chassis center -->
      <site name="imu_site" pos="0 0 0" size="0.005" rgba="0 0 1 0.5"/>

      <!-- Chassis coordinate frame visualization - on top of chassis -->
      <!-- Chassis is 40mm tall (±20mm), so top surface is at z=0.020 -->
      <site name="chassis_x_axis" type="cylinder" size="0.002 0.06" pos="0.06 0 0.025" euler="0 90 0" rgba="1 0 0 0.9"/>
      <site name="chassis_y_axis" type="cylinder" size="0.002 0.06" pos="0 0.06 0.025" euler="90 0 0" rgba="0 1 0 0.9"/>
      <site name="chassis_z_axis" type="cylinder" size="0.002 0.06" pos="0 0 0.08" euler="0 0 0" rgba="0 0 1 0.9"/>

      <!-- Motor number labels near each wheel on chassis top surface -->
      <!-- M1 = wheel_lf (X=+0.075, Y=+0.100) -->
      <site name="label_m1" type="sphere" pos="0.075 0.100 0.025" size="0.012" rgba="1 0.5 0 1"/>
      <!-- M2 = wheel_lr (X=+0.075, Y=-0.100) -->
      <site name="label_m2" type="sphere" pos="0.075 -0.100 0.025" size="0.012" rgba="0 1 0.5 1"/>
      <!-- M3 = wheel_rf (X=-0.075, Y=+0.100) -->
      <site name="label_m3" type="sphere" pos="-0.075 0.100 0.025" size="0.012" rgba="0 0.5 1 1"/>
      <!-- M4 = wheel_rr (X=-0.075, Y=-0.100) -->
      <site name="label_m4" type="sphere" pos="-0.075 -0.100 0.025" size="0.012" rgba="1 0 1 1"/>

      <!-- Left front wheel: X=+0.075 (right side), Y=+0.100 (front), Z=0 -->
      <!-- Wheel: diameter=65mm (radius=0.0325m), width=26mm (half-width=0.013m) -->
      <!-- Wheel axis parallel to X axis, rotates around X to drive forward (Y direction) -->
      <!-- Left side wheels rotate in opposite direction, so axis is reversed -->
      <body name="wheel_lf" pos="0.075 0.100 0">
        <joint name="jwheel_lf" type="hinge" axis="-1 0 0" damping="0.1"/>
        <geom name="wheel_lf" type="cylinder" size="0.0325 0.013"
              euler="0 90 0" mass="0.030" friction="1.5 0.005 0.0001"
              rgba="0.1 0.1 0.1 1"/>
        <inertial pos="0 0 0" mass="0.030" diaginertia="1.7e-5 3.3e-5 1.7e-5"/>
        <!-- Yellow marker on outer side of wheel -->
        <site name="marker_lf" pos="0.015 0 0.025" size="0.008" rgba="1 1 0 1"/>
      </body>

      <!-- Left rear wheel: X=+0.075 (right side), Y=-0.100 (rear), Z=0 -->
      <body name="wheel_lr" pos="0.075 -0.100 0">
        <joint name="jwheel_lr" type="hinge" axis="-1 0 0" damping="0.1"/>
        <geom name="wheel_lr" type="cylinder" size="0.0325 0.013"
              euler="0 90 0" mass="0.030" friction="1.5 0.005 0.0001"
              rgba="0.1 0.1 0.1 1"/>
        <inertial pos="0 0 0" mass="0.030" diaginertia="1.7e-5 3.3e-5 1.7e-5"/>
        <site name="marker_lr" pos="0.015 0 0.025" size="0.008" rgba="1 1 0 1"/>
      </body>

      <!-- Right front wheel: X=-0.075 (left side), Y=+0.100 (front), Z=0 -->
      <body name="wheel_rf" pos="-0.075 0.100 0">
        <joint name="jwheel_rf" type="hinge" axis="1 0 0" damping="0.1"/>
        <geom name="wheel_rf" type="cylinder" size="0.0325 0.013"
              euler="0 90 0" mass="0.030" friction="1.5 0.005 0.0001"
              rgba="0.1 0.1 0.1 1"/>
        <inertial pos="0 0 0" mass="0.030" diaginertia="1.7e-5 3.3e-5 1.7e-5"/>
        <site name="marker_rf" pos="-0.015 0 0.025" size="0.008" rgba="1 1 0 1"/>
      </body>

      <!-- Right rear wheel: X=-0.075 (left side), Y=-0.100 (rear), Z=0 -->
      <body name="wheel_rr" pos="-0.075 -0.100 0">
        <joint name="jwheel_rr" type="hinge" axis="1 0 0" damping="0.1"/>
        <geom name="wheel_rr" type="cylinder" size="0.0325 0.013"
              euler="0 90 0" mass="0.030" friction="1.5 0.005 0.0001"
              rgba="0.1 0.1 0.1 1"/>
        <inertial pos="0 0 0" mass="0.030" diaginertia="1.7e-5 3.3e-5 1.7e-5"/>
        <site name="marker_rr" pos="-0.015 0 0.025" size="0.008" rgba="1 1 0 1"/>
      </body>
    </body>
  </worldbody>

  <!-- Actuators: velocity control with reduced gain -->
  <actuator>
    <velocity name="act_lf" joint="jwheel_lf" kv="1" gear="1"/>
    <velocity name="act_lr" joint="jwheel_lr" kv="1" gear="1"/>
    <velocity name="act_rf" joint="jwheel_rf" kv="1" gear="1"/>
    <velocity name="act_rr" joint="jwheel_rr" kv="1" gear="1"/>
  </actuator>

  <!-- Sensors -->
  <sensor>
    <!-- Encoder: joint position for each wheel -->
    <jointpos name="enc_lf" joint="jwheel_lf"/>
    <jointpos name="enc_lr" joint="jwheel_lr"/>
    <jointpos name="enc_rf" joint="jwheel_rf"/>
    <jointpos name="enc_rr" joint="jwheel_rr"/>

    <!-- IMU: linear and angular velocity in chassis frame -->
    <framelinvel  name="imu_linvel"  objtype="site" objname="imu_site"/>
    <frameangvel  name="imu_angvel"  objtype="site" objname="imu_site"/>

    <!-- Debug sensors: chassis pose -->
    <framepos     name="chassis_pos" objtype="body" objname="chassis"/>
    <framequat    name="chassis_quat" objtype="body" objname="chassis"/>
  </sensor>
</mujoco>
