                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCAN_HPMS_BIDX</name>
                            <description>Buffer Index. Index of Rx FIFO element to which the message was stored. Only valid when MSI(1) = '1'.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-only</access>
