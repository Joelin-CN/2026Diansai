                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>GFCTL_AGFSEL_AGLIT_10</name>
                                    <description>AGLIT_10</description>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>GFCTL_AGFSEL_AGLIT_25</name>
                                    <description>AGLIT_25</description>
                                    <value>2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>GFCTL_AGFSEL_AGLIT_50</name>
                                    <description>AGLIT_50</description>
                                    <value>3</value>
                                </enumeratedValue>
                            </enumeratedValues>
