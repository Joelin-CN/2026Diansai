                                    <name>MCANSS_CLKSTS_STOPREQ_HW_OVR_SET</name>
                                    <description>SET</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>MCANSS_CLKSTS_CCLKDONE</name>
