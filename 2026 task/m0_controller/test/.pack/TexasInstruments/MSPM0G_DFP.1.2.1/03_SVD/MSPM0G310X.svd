                        </field>
                        <field>
                            <name>SOAR_OAREN</name>
                            <description>I2C Slave Own Address Enable</description>
                            <bitOffset>0xE</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <enumeratedValues>
