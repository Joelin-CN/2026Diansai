                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCAN_SIDFC_FLSSA</name>
                            <description>Filter List Standard Start Address. Start address of standard Message ID filter list (32-bit word address).</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0xE</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_SIDFC_LSS</name>
                            <description>List Size Standard
  0        No standard Message ID filter
  1-128  Number of standard Message ID filter elements
  &amp;gt;128   Values greater than 128 are interpreted as 128</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x8</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
