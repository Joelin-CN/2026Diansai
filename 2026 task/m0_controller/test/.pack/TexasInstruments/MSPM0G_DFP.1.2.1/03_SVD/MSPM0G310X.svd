                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>SCTR_TXWAIT_STALE_TXFIFO_ENABLE</name>
                                    <description>ENABLE</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
