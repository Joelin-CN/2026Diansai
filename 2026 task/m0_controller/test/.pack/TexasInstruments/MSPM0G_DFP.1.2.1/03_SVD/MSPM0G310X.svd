                                <enumeratedValue>
                                    <name>MCANSS_CLKCTL_WAKEUP_INT_EN_ENABLE</name>
                                    <description>ENABLE</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>MCANSS_CLKCTL_WKUP_GLTFLT_EN</name>
                            <description>Setting this bit enables the glitch filter on MCAN RXD input, which wakes up the MCAN controller to exit clock gating.</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>MCANSS_CLKCTL_WKUP_GLTFLT_EN_DISABLE</name>
                                    <description>DISABLE</description>
                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>MCANSS_CLKCTL_WKUP_GLTFLT_EN_ENABLE</name>
                                    <description>ENABLE</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
