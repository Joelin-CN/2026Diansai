                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>MCR_CLKSTRETCH_ENABLE</name>
                                    <description>ENABLE</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
