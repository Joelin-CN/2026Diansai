                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>SSR_BUSBSY_SET</name>
                                    <description>SET</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>SSR_TXMODE</name>
                            <description>Slave FSM is in TX MODE</description>
                            <bitOffset>0x7</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <enumeratedValues>
