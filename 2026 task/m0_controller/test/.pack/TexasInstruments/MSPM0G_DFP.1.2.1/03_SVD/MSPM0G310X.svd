                                    <name>CTTRIGCTL_EVTCTTRIGSEL_CCU1</name>
                                    <description>CCU1</description>
                                    <value>9</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CTTRIGCTL_EVTCTTRIGSEL_CCU2</name>
                                    <description>CCU2</description>
