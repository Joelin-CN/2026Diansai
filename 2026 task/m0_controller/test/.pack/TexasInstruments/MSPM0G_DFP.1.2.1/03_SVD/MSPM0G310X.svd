                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CTL0_CSSEL_CSSEL_2</name>
                                    <description>CSSEL_2</description>
                                    <value>2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CTL0_CSSEL_CSSEL_3</name>
