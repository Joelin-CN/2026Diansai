                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>SSR_TXMODE_SET</name>
                                    <description>SET</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>SSR_STALE_TXFIFO</name>
