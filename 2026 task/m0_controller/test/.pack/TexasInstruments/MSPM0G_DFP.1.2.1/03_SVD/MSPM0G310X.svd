                            <name>MCAN_TXBCIE_CFIE19</name>
                            <description>Cancellation Finished Interrupt Enable 19. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x13</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE20</name>
                            <description>Cancellation Finished Interrupt Enable 20. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x14</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE21</name>
                            <description>Cancellation Finished Interrupt Enable 21. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x15</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE22</name>
                            <description>Cancellation Finished Interrupt Enable 22. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x16</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE23</name>
                            <description>Cancellation Finished Interrupt Enable 23. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x17</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE24</name>
                            <description>Cancellation Finished Interrupt Enable 24. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE25</name>
                            <description>Cancellation Finished Interrupt Enable 25. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x19</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE26</name>
                            <description>Cancellation Finished Interrupt Enable 26. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x1A</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE27</name>
                            <description>Cancellation Finished Interrupt Enable 27. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x1B</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE28</name>
                            <description>Cancellation Finished Interrupt Enable 28. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x1C</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE29</name>
                            <description>Cancellation Finished Interrupt Enable 29. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x1D</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE30</name>
                            <description>Cancellation Finished Interrupt Enable 30. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x1E</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXBCIE_CFIE31</name>
                            <description>Cancellation Finished Interrupt Enable 31. Each Tx Buffer has its own Cancellation Finished Interrupt Enable bit.
  0  Cancellation finished interrupt disabled
  1  Cancellation finished interrupt enabled</description>
                            <bitOffset>0x1F</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCAN_TXEFC</name>
                    <description>MCAN Tx Event FIFO Configuration</description>
                    <addressOffset>0x70F0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCAN_TXEFC_EFSA</name>
                            <description>Event FIFO Start Address. Start address of Tx Event FIFO in Message RAM (32-bit word address).</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0xE</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXEFC_EFS</name>
                            <description>Event FIFO Size. The Tx Event FIFO elements are indexed from 0 to EFS - 1.
  0      Tx Event FIFO disabled
  1-32  Number of Tx Event FIFO elements
  &amp;gt;32   Values greater than 32 are interpreted as 32</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCAN_TXEFC_EFWM</name>
                            <description>Event FIFO Watermark
  0      Watermark interrupt disabled
  1-32  Level for Tx Event FIFO watermark interrupt (IR.TEFW)
  &amp;gt;32   Watermark interrupt disabled</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCAN_TXEFS</name>
                    <description>MCAN Tx Event FIFO Status</description>
                    <addressOffset>0x70F4</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCAN_TXEFS_EFFL</name>
                            <description>Event FIFO Fill Level. Number of elements stored in Tx Event FIFO, range 0 to 32.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCAN_TXEFS_EFGI</name>
                            <description>Event FIFO Get Index. Tx Event FIFO read index pointer, range 0 to 31.</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCAN_TXEFS_EFPI</name>
                            <description>Event FIFO Put Index.Tx Event FIFO write index pointer, range 0 to 31.</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCAN_TXEFS_EFF</name>
                            <description>Event FIFO Full
  0  Tx Event FIFO not full
  1  Tx Event FIFO full</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCAN_TXEFS_TEFL</name>
                            <description>Tx Event FIFO Element Lost. This bit is a copy of interrupt flag IR.TEFL. When IR.TEFL is reset, this bit is also reset.
  0  No Tx Event FIFO element lost
  1  Tx Event FIFO element lost, also set after write attempt to Tx Event FIFO of size zero.</description>
                            <bitOffset>0x19</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCAN_TXEFA</name>
                    <description>MCAN Tx Event FIFO Acknowledge</description>
                    <addressOffset>0x70F8</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCAN_TXEFA_EFAI</name>
                            <description>Event FIFO Acknowledge Index. After the Host has read an element or a sequence of elements from the Tx Event FIFO it has to write the index of the last element read from Tx Event FIFO to EFAI. This will set the Tx Event FIFO Get Index TXEFS.EFGI to EFAI + 1 and update the Event FIFO Fill Level TXEFS.EFFL.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_PID</name>
                    <description>MCAN Subsystem Revision Register</description>
                    <addressOffset>0x7200</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x68e04901</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_PID_MINOR</name>
                            <description>Minor Revision of the MCAN Subsystem</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANSS_PID_MAJOR</name>
                            <description>Major Revision of the MCAN Subsystem</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANSS_PID_MODULE_ID</name>
                            <description>Module Identification Number</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0xC</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANSS_PID_SCHEME</name>
                            <description>PID Register Scheme</description>
                            <bitOffset>0x1E</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_CTRL</name>
                    <description>MCAN Subsystem Control Register</description>
                    <addressOffset>0x7204</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000008</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_CTRL_DBGSUSP_FREE</name>
                            <description>Debug Suspend Free Bit. Enables debug suspend.
  0  Disable debug suspend
  1  Enable debug suspend</description>
                            <bitOffset>0x3</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANSS_CTRL_WAKEUPREQEN</name>
                            <description>Wakeup Request Enable. Enables the MCANSS to wakeup on CAN RXD activity.
  0  Disable wakeup request
  1  Enables wakeup request</description>
                            <bitOffset>0x4</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANSS_CTRL_AUTOWAKEUP</name>
                            <description>Automatic Wakeup Enable. Enables the MCANSS to automatically clear the MCAN CCCR.INIT bit, fully waking the MCAN up, on an enabled wakeup request.
  0  Disable the automatic write to CCCR.INIT
  1  Enable the automatic write to CCCR.INIT</description>
                            <bitOffset>0x5</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANSS_CTRL_EXT_TS_CNTR_EN</name>
                            <description>External Timestamp Counter Enable.
  0  External timestamp counter disabled
  1  External timestamp counter enabled</description>
                            <bitOffset>0x6</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_STAT</name>
                    <description>MCAN Subsystem Status Register</description>
                    <addressOffset>0x7208</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xfffffffb</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_STAT_RESET</name>
                            <description>Soft Reset Status.
  0  Not in reset
  1  Reset is in progress</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANSS_STAT_MEM_INIT_DONE</name>
                            <description>Memory Initialization Done.
  0  Message RAM initialization is in progress
  1  Message RAM is initialized for use</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANSS_STAT_ENABLE_FDOE</name>
                            <description>Flexible Datarate Operation Enable. Determines whether CAN FD operation may be enabled via the MCAN core CCCR.FDOE bit (bit 8) or if only standard CAN operation is possible with this instance of the MCAN.
  0  MCAN is only capable of standard CAN communication
  1  MCAN may be configured to perform CAN FD communication</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_ICS</name>
                    <description>MCAN Subsystem Interrupt Clear Shadow Register</description>
                    <addressOffset>0x720C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_ICS_EXT_TS_CNTR_OVFL</name>
                            <description>External Timestamp Counter Overflow Interrupt Status Clear. Reads always return a 0.
  0  Write of '0' has no effect
  1  Write of '1' clears the MCANSS_IRS.EXT_TS_CNTR_OVFL bit</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_IRS</name>
                    <description>MCAN Subsystem Interrupt Raw Satus Register</description>
                    <addressOffset>0x7210</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_IRS_EXT_TS_CNTR_OVFL</name>
                            <description>External Timestamp Counter Overflow Interrupt Status. This bit is set by HW or by a SW write of '1'. To clear, use the MCANSS_ICS.EXT_TS_CNTR_OVFL bit.
  0  External timestamp counter has not overflowed
  1  External timestamp counter has overflowed
 
When this bit is set to '1' by HW or SW, the MCANSS_EXT_TS_UNSERVICED_INTR_CNTR.EXT_TS_INTR_CNTR bit field will increment by 1.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_IECS</name>
                    <description>MCAN Subsystem Interrupt Enable Clear Shadow Register</description>
                    <addressOffset>0x7214</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_IECS_EXT_TS_CNTR_OVFL</name>
                            <description>External Timestamp Counter Overflow Interrupt Enable Clear. Reads always return a 0.
  0  Write of '0' has no effect
  1  Write of '1' clears the MCANSS_IES.EXT_TS_CNTR_OVFL bit</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_IE</name>
                    <description>MCAN Subsystem Interrupt Enable Register</description>
                    <addressOffset>0x7218</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_IE_EXT_TS_CNTR_OVFL</name>
                            <description>External Timestamp Counter Overflow Interrupt Enable. A write of '0' has no effect. A write of '1' sets the MCANSS_IES.EXT_TS_CNTR_OVFL bit.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_IES</name>
                    <description>MCAN Subsystem Interrupt Enable Status</description>
                    <addressOffset>0x721C</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_IES_EXT_TS_CNTR_OVFL</name>
                            <description>External Timestamp Counter Overflow Interrupt Enable Status. To set, use the CANSS_IE.EXT_TS_CNTR_OVFL bit. To clear, use the MCANSS_IECS.EXT_TS_CNTR_OVFL bit.
  0  External timestamp counter overflow interrupt is not enabled
  1  External timestamp counter overflow interrupt is enabled</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_EOI</name>
                    <description>MCAN Subsystem End of Interrupt</description>
                    <addressOffset>0x7220</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_EOI_EOI</name>
                            <description>End of Interrupt. A write to this register will clear the associated interrupt. If the unserviced interrupt counter is &amp;gt; 1, another interrupt is generated.
  0x00  External TS Interrupt is cleared
  0x01  MCAN(0) interrupt is cleared
  0x02  MCAN(1) interrupt is cleared
  Other writes are ignored.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x8</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_EXT_TS_PRESCALER</name>
                    <description>MCAN Subsystem External Timestamp Prescaler 0</description>
                    <addressOffset>0x7224</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_EXT_TS_PRESCALER_PRESCALER</name>
                            <description>External Timestamp Prescaler Reload Value. The external timestamp count rate is the host (system) clock rate divided by this value, except in the case of 0. A zero value in this bit field will act identically to a value of 0x000001.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x18</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANSS_EXT_TS_UNSERVICED_INTR_CNTR</name>
                    <description>MCAN Subsystem External Timestamp Unserviced Interrupts Counter</description>
                    <addressOffset>0x7228</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANSS_EXT_TS_UNSERVICED_INTR_CNTR_EXT_TS_INTR_CNTR</name>
                            <description>External Timestamp Counter Unserviced Rollover Interrupts. If this value is &amp;gt; 1, an MCANSS_EOI write of '1' to bit 0 will issue another interrupt.
 
The status of this bit field is affected by the MCANSS_IRS.EXT_TS_CNTR_OVFL bit field.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_REV</name>
                    <description>MCAN Error Aggregator Revision Register</description>
                    <addressOffset>0x7400</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x66a0ea00</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_REV_REVMIN</name>
                            <description>Minor Revision of the Error Aggregator</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_REV_REVMAJ</name>
                            <description>Major Revision of the Error Aggregator</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_REV_MODULE_ID</name>
                            <description>Module Identification Number</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0xC</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_REV_SCHEME</name>
                            <description>PID Register Scheme</description>
                            <bitOffset>0x1E</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_VECTOR</name>
                    <description>MCAN ECC Vector Register</description>
                    <addressOffset>0x7408</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_VECTOR_ECC_VECTOR</name>
                            <description>ECC RAM ID. Each error detection and correction (EDC) controller has a bank of error registers (offsets 0x10 - 0x3B) associated with it. These registers are accessed via an internal serial bus (SVBUS). To access them through the ECC aggregator the controller ID desired must be written to the ECC_VECTOR field, together with the RD_SVBUS trigger and RD_SVBUS_ADDRESS bit field. This initiates the serial read which consummates by setting the RD_SVBUS_DONE bit. At this point the addressed register may be read by a normal CPU read of the appropriate offset address.
  0x000  Message RAM ECC controller is selected
  Others  Reserved (do not use)
 
Subsequent writes through the SVBUS (offsets 0x10 - 0x3B) have a delayed completion. To avoid conflicts, perform a read back of a register within this range after writing.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0xB</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_VECTOR_RD_SVBUS</name>
                            <description>Read Trigger</description>
                            <bitOffset>0xF</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_VECTOR_RD_SVBUS_ADDRESS</name>
                            <description>Read Address Offset</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x8</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_VECTOR_RD_SVBUS_DONE</name>
                            <description>Read Completion Flag</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_STAT</name>
                    <description>MCAN Error Misc Status</description>
                    <addressOffset>0x740C</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000002</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_STAT_NUM_RAMS</name>
                            <description>Number of RAMs. Number of ECC RAMs serviced by the aggregator.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0xB</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_WRAP_REV</name>
                    <description>MCAN ECC Wrapper Revision Register</description>
                    <addressOffset>0x7410</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x66a46a02</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_WRAP_REV_REVMIN</name>
                            <description>Minor Revision of the Error Aggregator</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_WRAP_REV_REVMAJ</name>
                            <description>Major Revision of the Error Aggregator</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_WRAP_REV_MODULE_ID</name>
                            <description>Module Identification Number</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0xC</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_WRAP_REV_SCHEME</name>
                            <description>PID Register Scheme</description>
                            <bitOffset>0x1E</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_CTRL</name>
                    <description>MCAN ECC Control</description>
                    <addressOffset>0x7414</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000187</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_CTRL_ECC_ENABLE</name>
                            <description>Enable ECC Generation</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_ECC_CHECK</name>
                            <description>Enable ECC Check. ECC is completely bypassed if both ECC_ENABLE and ECC_CHECK are '0'.</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_ENABLE_RMW</name>
                            <description>Enable read-modify-write on partial word writes</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_FORCE_SEC</name>
                            <description>Force single-bit error. Cleared on a writeback or the cycle following the error if ERROR_ONCE is asserted. For write through mode, this applies to writes as well as reads. MCANERR_ERR_CTRL1 and MCANERR_ERR_CTRL2 should be configured prior to setting this bit.</description>
                            <bitOffset>0x3</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_FORCE_DED</name>
                            <description>Force double-bit error. Cleared the cycle following the error if ERROR_ONCE is asserted. For write through mode, this applies to writes as well as reads. MCANERR_ERR_CTRL1 and MCANERR_ERR_CTRL2 should be configured prior to setting this bit.</description>
                            <bitOffset>0x4</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_FORCE_N_ROW</name>
                            <description>Enable single/double-bit error on the next RAM read, regardless of the MCANERR_ERR_CTRL1.ECC_ROW setting. For write through mode, this applies to writes as well as reads.</description>
                            <bitOffset>0x5</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_ERROR_ONCE</name>
                            <description>If this bit is set, the FORCE_SEC/FORCE_DED will inject an error to the specified row only once. The FORCE_SEC bit will be cleared once a writeback happens. If writeback is not enabled, this error will be cleared the cycle following the read when the data is corrected. For double-bit errors, the FORCE_DED bit will be cleared the cycle following the double-bit error. Any subsequent reads will not force an error.</description>
                            <bitOffset>0x6</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_CTRL_CHECK_SVBUS_TIMEOUT</name>
                            <description>Enables Serial VBUS timeout mechanism</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_ERR_CTRL1</name>
                    <description>MCAN ECC Error Control 1 Register</description>
                    <addressOffset>0x7418</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_ERR_CTRL1_ECC_ROW</name>
                            <description>Row address where FORCE_SEC or FORCE_DED needs to be applied. This is ignored if FORCE_N_ROW is set.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x20</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_ERR_CTRL2</name>
                    <description>MCAN ECC Error Control 2 Register</description>
                    <addressOffset>0x741C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_ERR_CTRL2_ECC_BIT1</name>
                            <description>Column/Data bit that needs to be flipped when FORCE_SEC or FORCE_DED is set</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x10</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_CTRL2_ECC_BIT2</name>
                            <description>Second column/data bit that needs to be flipped when FORCE_DED is set</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x10</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_ERR_STAT1</name>
                    <description>MCAN ECC Error Status 1 Register</description>
                    <addressOffset>0x7420</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_ERR_STAT1_ECC_SEC</name>
                            <description>Single Bit Error Corrected Status. A 2-bit saturating counter of the number of SEC errors that have occurred since last cleared.
 
  0  No single-bit error detected
  1  One single-bit error was detected and corrected
  2  Two single-bit errors were detected and corrected
  3  Three single-bit errors were detected and corrected
 
A write of a non-zero value to this bit field increments it by the value provided.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_ECC_DED</name>
                            <description>Double Bit Error Detected Status. A 2-bit saturating counter of the number of DED errors that have occurred since last cleared.
 
  0  No double-bit error detected
  1  One double-bit error was detected
  2  Two double-bit errors were detected
  3  Three double-bit errors were detected
 
A write of a non-zero value to this bit field increments it by the value provided.</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_ECC_OTHER</name>
                            <description>SEC While Writeback Error Status
  0  No SEC error while writeback pending
  1  Indicates that successive single-bit errors have occurred while a writeback is still pending</description>
                            <bitOffset>0x4</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_CTRL_REG_ERROR</name>
                            <description>Control Register Error. A bit field in the control register is in an ambiguous state. This means that the redundancy registers have detected a state where not all values are the same and has defaulted to the reset state. S/W needs to re-write these registers to a known state. A write of 1 will set this interrupt flag.</description>
                            <bitOffset>0x7</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_CLR_ECC_SEC</name>
                            <description>Clear ECC_SEC. A write of a non-zero value to this bit field decrements the ECC_SEC bit field by the value provided.</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_CLR_ECC_DED</name>
                            <description>Clear ECC_DED. A write of a non-zero value to this bit field decrements the ECC_DED bit field by the value provided.</description>
                            <bitOffset>0xA</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_CLR_ECC_OTHER</name>
                            <description>Writing a '1' clears the ECC_OTHER bit.</description>
                            <bitOffset>0xC</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_CLR_CTRL_REG_ERROR</name>
                            <description>Writing a '1' clears the CTRL_REG_ERROR bit</description>
                            <bitOffset>0xF</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT1_ECC_BIT1</name>
                            <description>ECC Error Bit Position. Indicates the bit position in the RAM data that is in error on an SEC error. Only valid on an SEC error.
  0  Bit 0 is in error
  1  Bit 1 is in error
  2  Bit 2 is in error
  3  Bit 3 is in error
  ...
  31 Bit 31 is in error
  &amp;gt;32 Invalid</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x10</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_ERR_STAT2</name>
                    <description>MCAN ECC Error Status 2 Register</description>
                    <addressOffset>0x7424</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_ERR_STAT2_ECC_ROW</name>
                            <description>Indicates the row address where the single or double-bit error occurred. This value is address offset/4.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x20</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_ERR_STAT3</name>
                    <description>MCAN ECC Error Status 3 Register</description>
                    <addressOffset>0x7428</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_ERR_STAT3_WB_PEND</name>
                            <description>Delayed Write Back Pending Status
  0  No write back pending
  1  An ECC data correction write back is pending</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT3_SVBUS_TIMEOUT</name>
                            <description>Serial VBUS Timeout Flag. Write 1 to set.</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_ERR_STAT3_CLR_SVBUS_TIMEOUT</name>
                            <description>Write 1 to clear the Serial VBUS Timeout Flag</description>
                            <bitOffset>0x9</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_SEC_EOI</name>
                    <description>MCAN Single Error Corrected End of Interrupt Register</description>
                    <addressOffset>0x743C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_SEC_EOI_EOI_WR</name>
                            <description>Write to this register indicates that software has acknowledged the pending interrupt and the next interrupt can be sent to the host.
 
Note that a write to the  MCANERR_ERR_STAT1.CLR_ECC_SEC goes through the SVBUS and has a delayed completion. To avoid an additional interrupt, read the MCANERR_ERR_STAT1 register back prior to writing to this bit field.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_SEC_STATUS</name>
                    <description>MCAN Single Error Corrected Interrupt Status Register</description>
                    <addressOffset>0x7440</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_SEC_STATUS_MSGMEM_PEND</name>
                            <description>Message RAM SEC Interrupt Pending
  0  No SEC interrupt is pending
  1  SEC interrupt is pending</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_SEC_ENABLE_SET</name>
                    <description>MCAN Single Error Corrected Interrupt Enable Set Register</description>
                    <addressOffset>0x7480</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_SEC_ENABLE_SET_MSGMEM_ENABLE_SET</name>
                            <description>Message RAM SEC Interrupt Pending Enable Set. Writing a 1 to this bit enables the Message RAM SEC error interrupts. Writing a 0 has no effect. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_SEC_ENABLE_CLR</name>
                    <description>MCAN Single Error Corrected Interrupt Enable Clear Register</description>
                    <addressOffset>0x74C0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_SEC_ENABLE_CLR_MSGMEM_ENABLE_CLR</name>
                            <description>Message RAM SEC Interrupt Pending Enable Clear. Writing a 1 to this bit disables the Message RAM SEC error interrupts. Writing a 0 has no effect. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_DED_EOI</name>
                    <description>MCAN Double Error Detected End of Interrupt Register</description>
                    <addressOffset>0x753C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_DED_EOI_EOI_WR</name>
                            <description>Write to this register indicates that software has acknowledged the pending interrupt and the next interrupt can be sent to the host.
 
Note that a write to the  MCANERR_ERR_STAT1.CLR_ECC_DED goes through the SVBUS and has a delayed completion. To avoid an additional interrupt, read the MCANERR_ERR_STAT1 register back prior to writing to this bit field.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_DED_STATUS</name>
                    <description>MCAN Double Error Detected Interrupt Status Register</description>
                    <addressOffset>0x7540</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_DED_STATUS_MSGMEM_PEND</name>
                            <description>Message RAM DED Interrupt Pending
  0  No DED interrupt is pending
  1  DED interrupt is pending</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_DED_ENABLE_SET</name>
                    <description>MCAN Double Error Detected Interrupt Enable Set Register</description>
                    <addressOffset>0x7580</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_DED_ENABLE_SET_MSGMEM_ENABLE_SET</name>
                            <description>Message RAM DED Interrupt Pending Enable Set. Writing a 1 to this bit enables the Message RAM DED error interrupts. Writing a 0 has no effect. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_DED_ENABLE_CLR</name>
                    <description>MCAN Double Error Detected Interrupt Enable Clear Register</description>
                    <addressOffset>0x75C0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_DED_ENABLE_CLR_MSGMEM_ENABLE_CLR</name>
                            <description>Message RAM DED Interrupt Pending Enable Clear. Writing a 1 to this bit disables the Message RAM DED error interrupts. Writing a 0 has no effect. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_AGGR_ENABLE_SET</name>
                    <description>MCAN Error Aggregator Enable Set Register</description>
                    <addressOffset>0x7600</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_AGGR_ENABLE_SET_ENABLE_PARITY_SET</name>
                            <description>Write 1 to enable parity errors. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_AGGR_ENABLE_SET_ENABLE_TIMEOUT_SET</name>
                            <description>Write 1 to enable timeout errors. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_AGGR_ENABLE_CLR</name>
                    <description>MCAN Error Aggregator Enable Clear Register</description>
                    <addressOffset>0x7604</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_AGGR_ENABLE_CLR_ENABLE_PARITY_CLR</name>
                            <description>Write 1 to disable parity errors. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_AGGR_ENABLE_CLR_ENABLE_TIMEOUT_CLR</name>
                            <description>Write 1 to disable timeout errors. Reads return the corresponding enable bit's current value.</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_AGGR_STATUS_SET</name>
                    <description>MCAN Error Aggregator Status Set Register</description>
                    <addressOffset>0x7608</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_AGGR_STATUS_SET_AGGR_PARITY_ERR</name>
                            <description>Aggregator Parity Error Status
 
2-bit saturating counter of the number of parity errors that have occurred since last cleared.
  0  No parity errors have occurred
  1  One parity error has occurred
  2  Two parity errors have occurred
  3  Three parity errors have occurred
 
A write of a non-zero value to this bit field increments it by the value provided.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_AGGR_STATUS_SET_SVBUS_TIMEOUT</name>
                            <description>Aggregator Serial VBUS Timeout Error Status
 
2-bit saturating counter of the number of SVBUS timeout errors that have occurred since last cleared.
  0  No timeout errors have occurred
  1  One timeout error has occurred
  2  Two timeout errors have occurred
  3  Three timeout errors have occurred
 
A write of a non-zero value to this bit field increments it by the value provided.</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCANERR_AGGR_STATUS_CLR</name>
                    <description>MCAN Error Aggregator Status Clear Register</description>
                    <addressOffset>0x760C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MCANERR_AGGR_STATUS_CLR_AGGR_PARITY_ERR</name>
                            <description>Aggregator Parity Error Status
 
2-bit saturating counter of the number of parity errors that have occurred since last cleared.
  0  No parity errors have occurred
  1  One parity error has occurred
  2  Two parity errors have occurred
  3  Three parity errors have occurred
 
A write of a non-zero value to this bit field decrements it by the value provided.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MCANERR_AGGR_STATUS_CLR_SVBUS_TIMEOUT</name>
                            <description>Aggregator Serial VBUS Timeout Error Status
 
2-bit saturating counter of the number of SVBUS timeout errors that have occurred since last cleared.
  0  No timeout errors have occurred
  1  One timeout error has occurred
  2  Two timeout errors have occurred
  3  Three timeout errors have occurred
 
A write of a non-zero value to this bit field decrements it by the value provided.</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
