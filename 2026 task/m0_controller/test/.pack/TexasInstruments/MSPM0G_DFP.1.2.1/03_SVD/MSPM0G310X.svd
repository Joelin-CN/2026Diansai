                        <field>
                            <name>MCAN_HPMS_MSI</name>
                            <description>Message Storage Indicator
  00  No FIFO selected
  01  FIFO message lost
  10  Message stored in FIFO 0
  11  Message stored in FIFO 1</description>
                            <bitOffset>0x6</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCAN_HPMS_FIDX</name>
                            <description>Filter Index. Index of matching filter element. Range is 0 to SIDFC.LSS - 1 resp. XIDFC.LSE - 1.</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x7</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MCAN_HPMS_FLST</name>
                            <description>Filter List. Indicates the filter list of the matching filter element.
  0  Standard Filter List
  1  Extended Filter List</description>
                            <bitOffset>0xF</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
