                                    <description>FSUB0</description>
                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CTTRIGCTL_EVTCTTRIGSEL_FSUB1</name>
                                    <description>FSUB1</description>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
