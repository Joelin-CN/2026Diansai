                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>LINCTL_LINC0_MATCH_ENABLE</name>
                                    <description>ENABLE</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
