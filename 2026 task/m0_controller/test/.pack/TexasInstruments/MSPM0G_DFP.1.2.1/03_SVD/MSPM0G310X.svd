                                    <value>3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CTRCTL_CZC_QEI_2INP</name>
                                    <description>QEI_2INP</description>
                                    <value>4</value>
                                </enumeratedValue>
                                <enumeratedValue>
