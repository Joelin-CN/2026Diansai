                        <field>
                            <name>SCTR_TXTRIG_TXMODE</name>
                            <description>Tx Trigger when slave FSM is in Tx Mode</description>
                            <bitOffset>0x4</bitOffset>
                            <bitWidth>0x1</bitWidth>
