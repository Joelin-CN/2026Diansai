                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>GFCTL_DGFSEL_CLK_2</name>
                                    <description>CLK_2</description>
                                    <value>2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>GFCTL_DGFSEL_CLK_3</name>
                                    <description>CLK_3</description>
